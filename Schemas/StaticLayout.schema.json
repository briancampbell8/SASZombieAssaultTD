{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Layout Schema",
  "type": "object",
  "properties": {
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "type": { "type": "string" }
        },
        "required": ["x", "y", "type"]
      }
    }
  },
  "required": ["tiles"]
}
